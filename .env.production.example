# Coolify — Docker Compose build pack → docker-compose.coolify.yml
# Compose supplies DB/Redis/APP_ENV. Do not duplicate those here.

APP_KEY=

# Coolify injects SERVICE_URL_APP / SERVICE_FQDN_APP.
# config/app.php: APP_URL ← SERVICE_URL_APP (override only if SERVICE_* missing).
# TRUSTED_PROXIES=* is set in compose environment.

# Do not seed a production password via OPS_SEED_*. Create the first operator out of band.

# Fleet API (encrypted in Coolify env; never git). Add after first login if needed:
# COOLIFY_BASE_URL=https://your-coolify.example
# COOLIFY_API_TOKEN=
# COOLIFY_DEFAULT_PROJECT_UUID=
# COOLIFY_DEFAULT_SERVER_UUID=
# COOLIFY_WEBHOOK_SECRET=

# Faz B:
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_ORG=deamon-themes
# GITHUB_WEBHOOK_SECRET=
