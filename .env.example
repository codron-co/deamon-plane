APP_NAME="Deamon Plane"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Coolify injects SERVICE_URL_APP. APP_URL wins when set; otherwise SERVICE_URL_APP.
APP_URL=http://localhost:8088
APP_PORT=8088
# APP_URL=
# SERVICE_URL_APP=https://ops.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=plane
DB_USERNAME=plane
DB_PASSWORD=plane

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS="ops@localhost.test"
MAIL_FROM_NAME="${APP_NAME}"

TRUSTED_PROXIES=*

# Local super_admin seed: php artisan db:seed
# Production: do not set these; create the first operator out of band.
OPS_SEED_NAME="Plane Super Admin"
OPS_SEED_EMAIL=ops@localhost.test
OPS_SEED_PASSWORD=password

COOLIFY_BASE_URL=
COOLIFY_API_TOKEN=
COOLIFY_DEFAULT_PROJECT_UUID=
COOLIFY_DEFAULT_SERVER_UUID=
COOLIFY_WEBHOOK_SECRET=

DEAMON_GIT_REPOSITORY=https://github.com/codron-co/deamon.git
DEAMON_COMPOSE_FILE=docker-compose.coolify.yml
DEAMON_CHANNELS=main,beta,alpha

GITHUB_ORG=deamon-themes
GITHUB_THEME_REPO_PREFIX=deamon-theme-
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

CONTROL_PLANE_URL=http://localhost:8088
CONTROL_PLANE_AGENT_SKEW_SECONDS=60
