# Copy to .env (gitignored). Do not commit tokens.
# Coolify Keys & Tokens → API Token (least privilege).

COOLIFY_BASE_URL=https://coolify.example.com
COOLIFY_API_TOKEN=

# Staging only — never a production customer app.
COOLIFY_STAGING_APP_UUID=
COOLIFY_DEFAULT_PROJECT_UUID=
COOLIFY_DEFAULT_SERVER_UUID=

# Optional: GitHub App UUID on Coolify (private repo create).
COOLIFY_GITHUB_APP_UUID=

# Optional mutate: only with spike.ps1 -Mutate (alpha↔beta on STAGING app).
# SPIKE_MUTATE=0
# SPIKE_TARGET_BRANCH=alpha
